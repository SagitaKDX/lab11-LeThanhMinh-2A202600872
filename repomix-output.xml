    "        if hasattr(event, 'content') and event.content and event.content.parts:\n",
    "            for part in event.content.parts:\n",
    "                if hasattr(part, 'text') and part.text:\n",
    "                    final_response += part.text\n",
    "\n",
    "    return final_response, session\n",
